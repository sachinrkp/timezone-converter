# TimeZoneDB API Key (required)
# Get your free API key at https://timezonedb.com
TIMEZONEDB_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase (Authentication + Firestore) - from your Firebase project settings
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional: Custom API endpoint
# TIMEZONEDB_BASE_URL=https://api.timezonedb.com/v2.1
