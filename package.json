{
  "name": "utility-tools",
  "version": "2.0.0",
  "description": "Complete productivity suite with timezone conversion, notes management, calendar integration, and more",
  "main": "src/simple-server.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/simple-server.js",
    "dev": "npm run build && node dist/simple-server.js",
    "build": "tsc && npm run build:css && node -e \"require('fs').copyFileSync('dist/frontend.js','public/script.js')\"",
    "build:css": "npx tailwindcss -i ./public/style.css -o ./public/output.css",
    "vercel-build": "npm run build",
    "build:css:watch": "npx tailwindcss -i ./public/style.css -o ./public/output.css --watch",
    "test": "echo 'jest/ts-jest temporarily removed - blocked by Artifactory security policy (handlebars dependency), see README' && exit 1",
    "lint": "echo 'eslint temporarily removed - blocked by Artifactory security policy (flatted dependency), see README' && exit 1",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "utility-tools",
    "productivity",
    "timezone-converter",
    "notes-management",
    "calendar",
    "authentication",
    "encryption",
    "tailwind",
    "express",
    "node",
    "typescript"
  ],
  "author": "Sachin",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.22.3",
    "node-fetch": "^3.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
